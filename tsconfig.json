{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist-ts",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "vite": ["./node_modules/vite/dist/node/index.d.ts"]
    }
  },
  "include": [
    "server.ts",
    "server-entry.ts"
  ]
}