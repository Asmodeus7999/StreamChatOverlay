{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamChat",
  "version": "1.1.0",
  "identifier": "com.asmodeus.streamchat",
  "build": {
    "beforeDevCommand": "node start-server.cjs",
    "devUrl": "http://127.0.0.1:5000",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StreamChat Overlay",
        "url": "http://127.0.0.1:5000",
        "width": 400,
        "height": 520,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "resources/server": "server",
      "resources/public": "public"
    }
  }
}