{
  "name": "streamchat",
  "version": "1.1.1",
  "description": "A real-time chat overlay for TikTok Live and YouTube Live, packaged as a Tauri desktop app with a local Node.js + Express backend.",
  "scripts": {
    "clean": "npx rimraf release dist-ts server-dist src-tauri/target",
    "clean:full": "npm run clean && npx rimraf src-tauri/resources/server/node.exe",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx kill-port 5000 --silent && npx tauri dev",
    "tauri": "tauri",
    "build:server": "npx esbuild server-entry.ts --bundle --platform=node --target=node26 --outfile=src-tauri/resources/server/server.cjs --external:vite --external:tiktok-live-connector --external:youtube-chat",
    "build:frontend": "vite build",
    "build:tauri-resources": "node scripts/prepare-tauri-resources.mjs",
    "build": "npm run build:server && npm run build:frontend && npm run build:tauri-resources && npx tauri build",
    "build:portable": "npm run build && node scripts/portable-zip.mjs",
    "postinstall": "node scripts/patch-youtube-chat.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asmodeus7999/StreamChatOverlay.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Asmodeus7999/StreamChatOverlay/issues"
  },
  "homepage": "https://github.com/Asmodeus7999/StreamChatOverlay#readme",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tiktok-live-connector": "^2.4.4",
    "youtube-chat": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
